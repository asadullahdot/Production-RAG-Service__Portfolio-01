# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=rag-service
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

LLM_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# false = no-auth MVP mode (fixed default owner). true = B1 JWT auth.
AUTH_ENABLED=false
JWT_SECRET=
SIGNUP_ENABLED=true
MAX_USERS=50

RATE_LIMIT_PER_MIN=20
SIMILARITY_THRESHOLD=0.30
ENV=dev
