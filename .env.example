# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Qdrant Cloud free cluster: endpoint URL (no port needed) + API key. QDRANT_PATH=:memory: = embedded mode (no server).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

LLM_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# true (default) = B1 login required. false = no login, everyone shares one fixed owner (demo only).
AUTH_ENABLED=true
# Required when AUTH_ENABLED=true: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SIGNUP_ENABLED=true
MAX_USERS=50

RATE_LIMIT_PER_MIN=20
SIMILARITY_THRESHOLD=0.15
# Comma-separated upload types. pptx, txt and md are the B5 types; remove them to go back to pdf and docx only.
ALLOWED_FILE_TYPES=pdf,docx,pptx,txt,md
# A model screens each question for injection/jailbreak before the vector search (about +2-3 s per question). false = patterns only.
INPUT_SCREEN=true
ENV=dev
# B3 monitoring: traces and metrics of each request are kept in SQLite (no question or document text). false = off.
TELEMETRY_ENABLED=true
TRACE_KEEP=5000
# Every other setting (TOP_K, MAX_UPLOAD_MB, timeouts, DEMO_FAULT, ...) has a default in app/config.py; the full table is PLAN.md section 6.
