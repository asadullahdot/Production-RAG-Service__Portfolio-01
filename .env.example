# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Qdrant Cloud free cluster: endpoint URL (no port needed) + API key. QDRANT_PATH=:memory: = embedded mode (no server).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

LLM_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-terra
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# false = no-auth MVP mode (fixed default owner). true = B1 JWT auth.
AUTH_ENABLED=false
JWT_SECRET=
SIGNUP_ENABLED=true
MAX_USERS=50

RATE_LIMIT_PER_MIN=20
SIMILARITY_THRESHOLD=0.30
ENV=dev
